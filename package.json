{
  "name": "word-clone",
  "version": "0.1.0",
  "description": "An MS Word-style desktop word processor built with Electron, Vite, React, and native OOXML editing via @eigenpal/docx-editor.",
  "main": "./out/main/index.js",
  "author": "Word Clone",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:dir": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:smoke": "tsx --test src/main/ipc/fileFormats.smoke.test.ts",
    "test:docx-roundtrip": "node tests/scripts/generate-docx-fixtures.mjs && tsx --test tests/docx-roundtrip.test.ts",
    "test:fixtures:generate": "node tests/scripts/generate-docx-fixtures.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@eigenpal/docx-editor-agents": "^1.9.0",
    "@eigenpal/docx-editor-core": "^1.9.0",
    "@eigenpal/docx-editor-react": "^1.9.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/genai": "^2.8.0",
    "fast-diff": "^1.3.0",
    "lucide-react": "^1.17.0",
    "openai": "^6.44.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jszip": "^3.10.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7"
  }
}
